<% provide :title, " | 受講生検索" %>
<div class="student_wrapper wf-roundedmplus1c">
  <h2 class="form_title">受講生検索</h2>
  <p class="center_line">名前をクリックすると詳細が表示されます。</p>
  <div class="row">
    <div class="input-field col s12">
      <div class="row">
        <div class="col s4">
          <%= form_tag('/students/search', method: :get) do %>
          <input name="keyword" placeholder="性で検索" type="text" value=""><button class="btn-search btn-flat" title="検索" type="submit"><i class="material-icons">search</i></button></input>
          <% end %>
        </div>
      </div>
      <div class="row">
        <div class="col s12">
          <% if @students.present? %>
          <table class="t_border striped centered">
            <thead>
              <tr>
                <th>受講期</th>
                <th>名前</th>
                <th>進捗シート</th>
                <th>TM</th>
                <th>面談日</th>
              </tr>
            </thead>
            <tbody>
              <% @students.each do |student| %>
              <tr>
                <td class="table_center"><%= student.term %></td>
                <td><%= link_to student.name, student_path(student.id) %></td>
                <% if student.sheet.present? %>
                <td><%= link_to "表示する", student.sheet, target: "_blank" %></td>
                <% else %>
                <td>未登録</td>
                <% end %>
                <% if student.detail.present? %>
                <td><%= link_to "表示する", student.detail, target: "_blank" %></td>
                <% else %>
                <td>未登録</td>
                <% end %>
                <td><%= link_to "登録する", new_schedule_path(student_id: student.id) %></td>
                </tr>
                <% end %>
              </tbody>
            </table>
            <%= paginate(@students) %>
            <% else %>
            <p>該当する受講生はいません。</p>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>
