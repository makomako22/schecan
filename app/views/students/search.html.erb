<% provide :title, " | 受講生検索" %>
  <h2 class="form_title">受講生検索</h2>
  <p class="center-align">名前をクリックすると詳細が表示されます。</p>
  <div class="row">
    <div class="row">
      <div class="col s12">
        <% if @students.present? %>
        <table class="t_border striped centered">
          <thead>
            <tr>
              <th>拠点</th>
              <th>受講期</th>
              <th>名前</th>
              <th>進捗シート</th>
              <th>TM</th>
              <th>面談日</th>
            </tr>
          </thead>
          <tbody>
            <% @students.each do |student| %>
            <tr>
              <td class="table_center"><%= student.base.name %></td>
              <% if student.term == 1000 %>
              <td>--</td>
              <% else %>
              <td><span class="tooltipped" data-position="bottom" data-tooltip="<%= student.get_student_term(student) %>"><%= student.term %></span></td>
              <% end %>
              <td><%= link_to student.name, student_path(student.id) %></td>
              <td><%= link_to_if(student.sheet?, "表示する", student.sheet, target: "_blank") {"未登録"} %></td>
              <td><%= link_to_if(student.detail?, "表示する", student.detail, target: "_blank") {"未登録"} %></td>
              <td><%= link_to "登録する", new_schedule_path(student_id: student.id) %></td>
            </tr>
            <% end %>
          </tbody>
        </table>
        <%= paginate(@students) %>
        <% else %>
        <p>該当する受講生はいません。</p>
        <% end %>
      </div>
    </div>
  </div>
</div>
