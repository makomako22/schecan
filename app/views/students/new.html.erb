<% provide :title, " | 新規受講生登録" %>
<div class="form_wrapper wf-roundedmplus1c">
  <h2 class="form_title">新規受講生登録</h2>
  <p class="center-align">※「＊」は必須項目</p>
  <%= render partial: 'layouts/flash' %>
  <div class="row">
    <div class="col s12">
      <%= form_for(@student) do |f| %>
      <div class="row">
        <% if params[:term].blank? %>
        <div class="col s6">
          <%= f.label :"受講期＊" %>
          <%= f.collection_select :term, @terms, :term_i, :term_t, { prompt: '選択してください' }, {class: "browser-default"} %>
        </div>
        <% else %>
        <%= f.hidden_field :term %>
        <% end %>
        <% if params[:base_id].blank? %>
        <div class="col s6">
          <%= f.label :"拠点＊" %>
          <%= f.collection_select :base_id, @bases, :id, :name, { prompt: '選択してください' }, {class: "browser-default"} %>
        </div>
        <% else %>
        <div class="col s6">
          <%= f.label :"拠点＊" %>
          <%= f.collection_select :base_id, @bases, :id, :name, { selected: params[:base_id] }, {class: "browser-default"} %>
        </div>
        <% end %>
      </div>
      <div class="row">
        <div class="input-field col s6">
          <%= f.label :"姓(漢字)＊" %>
          <%= f.text_field :family_name, class: "validate" %>
        </div>
        <div class="input-field col s6">
          <%= f.label :"名(漢字)＊" %>
          <%= f.text_field :first_name, class: "validate" %>
        </div>
      </div>
      <div class="row">
        <div class="input-field col s6">
          <%= f.label :"性(カナ)＊" %>
          <%= f.text_field :family_name_kana %>
        </div>
        <div class="input-field col s6">
          <%= f.label :"名(カナ)＊" %>
          <%= f.text_field :first_name_kana %>
        </div>
      </div>
      <div class="row">
        <div class="input-field col s12">
          <%= f.label :"進捗シートリンク" %>
          <%= f.text_field :sheet %>
        </div>
      </div>
      <div class="row">
        <div class="input-field col s12">
          <%= f.label :"アイスバーグリンク" %>
          <%= f.text_field :iceberg %>
        </div>
      </div>
      <div class="row">
        <div class="input-field col s12 tc">
          <%= f.label :"TECH::MASTERリンク" %>
          <%= f.text_field :detail %>
        </div>
      </div>
      <div class="row">
        <div id="submit">
          <%= f.submit "送信",id: "submit_button", data: { disable_with: "送信中..." }, class: "btn waves-effect waves-light" %>
        </div>
      </div>
      <br>
    </div>
  </div>
  <% end %>
</div>
