<% provide :title, " | ログイン" %>
<div class="login_wrapper wf-roundedmplus1c">
  <h2 class="form_title">ログイン</h2>
  <%= render partial: 'layouts/flash' %>
  <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
  <div class="row">
    <div class="col s12">
      <div class="center">
        <div class="input-field">
          <%= f.label :email %><br />
          <%= f.email_field :email, autofocus: true, autocomplete: "email" %>
        </div>

        <div class="row">
          <div class="input-field">
            <%= f.label :パスワード %><br />
            <%= f.password_field :password, autocomplete: "off" %>
          </div>
        </div>

        <% if devise_mapping.rememberable? %>
        <div>
          <%= f.check_box :remember_me %>
          <%= f.label :remember_me, 'ログイン情報を記憶する' %>
        </div>
        <% end %>
        <br><br>
        <div class="row">
          <div id="submit">
            <%= f.submit "ログイン",id: "submit_button", data: { disable_with: "送信中..." }, class: "btn waves-effect waves-light" %>
          </div>
          <% end %>
        </div>
        <br>
      </div>
    </div>
  </div>
  <p class="center">パスワードを忘れた方は拠点責任者まで。</p>
  <br>
</div>
