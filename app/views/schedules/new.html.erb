<% provide :title, " | 新規面談日登録" %>
<div class="form_wrapper wf-roundedmplus1c">
  <%= form_for(@schedule) do |f| %>
  <h2 class="form_title">新規面談日登録</h2>
  <p class="center-align">※「<span class="red-text">＊</span>」は必須項目</p>
  <%= render partial: 'layouts/flash' %>
  <div class="row">
    <div class="col s12">
      <div class="row">
        <div class="input-field col s6">
          <p>面談日<span class="red-text">＊</span></p>
          <%= f.datetime_field :schedule_at_date, class: "datepicker", placeholder: "クリックして選択してください" %>
        </div>
        <div class="input-field col s6">
          <p>時間<span class="red-text">＊</span></p>
          <%= f.datetime_field :schedule_at_time, class: "timepicker", placeholder: "クリックして選択してください" %>
        </div>
      </div>
      <div class="row">
        <div class="col s6">
          <p>記入メンター名<span class="red-text">＊</span></p>
          <% if @student.schedules.present? %>
            <%= f.text_field :mentor,value: current_user.username, placeholder: "初回は「初回」と記入" %>
          <% else %>
            <%= f.text_field :mentor,value: "初回", placeholder: "初回は「初回」と記入" %>
          <% end %>
        </div>
      </div>
      <div class="row">
        <div class="col s12">
          <p>伝言メモ</p>
          <%= f.text_area :memo, placeholder: "（例）次回は16時以降をご希望です。\n（例）何行でも改行できます。", class: "materialize-textarea" %>
        </div>
      </div>
      <%= f.hidden_field :student_id %>
      <%= f.hidden_field :base_id %>
      <div class="row">
        <div id="submit">
          <%= f.submit "送信",id: "submit_button", data: { disable_with: "送信中..." }, class: "btn waves-effect waves-light" %>
        </div>
      </div>
      <br>
    </div>
  </div>
  <% end %>
</div>

