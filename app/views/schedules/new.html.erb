<% provide :title, " | 新規面談日登録" %>
<div class="form_wrapper wf-roundedmplus1c">
  <%= form_for(@schedule) do |f| %>
  <h2 class="form_title">新規面談日登録</h2>
  <p class="center_line">※「＊」は必須項目</p>
  <% if flash[:notice] %>
  <div id="card-alert" class="card green lighten-5">
    <div class="card-content green-text">
      <%= flash[:notice] %>
    </div>
  </div>
  <% end %>
  <% if flash[:alert] %>
  <div id="card-alert" class="card red lighten-5">
    <div class="card-content red-text">
      <%= flash[:alert] %>
    </div>
  </div>
  <% end %>
  <div class="row">
    <div class="col s12">
      <div class="row">
        <div class="input-field col s6">
          <p>＊次回面談日時</p>
          <%= f.datetime_field :schedule_at, value: Time.now.strftime("%Y-%m-%d 00:00") %>
        </div>
      </div>
      <div class="row">
        <div class="input-field col s6">
          <%= f.label :"＊記入メンター名 ※初回は「初回」と記入" %>
          <%= f.text_field :mentor %>
        </div>
      </div>
      <div class="row">
        <div class="input-field col s12">
          <%= f.label :"メモ" %>
          <%= f.text_area :memo, class: "materialize-textarea" %>
        </div>
      </div>
      <%= f.hidden_field :student_id %>
      <div class="row">
        <div id="submit">
          <%= f.submit "送信",id: "submit_button", class: "waves-effect waves-light red btn" %>
        </div>
      </div>
    </div>
  </div>
  <% end %>
</div>

