<% provide :title, " | 新規面談日登録" %>
<div class="form_wrapper wf-roundedmplus1c">
  <%= form_for(@schedule) do |f| %>
  <h2 class="form_title">新規面談日登録</h2>
  <p class="center_line">※「<span class="red-text">＊</span>」は必須項目</p>
  <%= render partial: 'layouts/flash' %>
  <div class="row">
    <div class="col s12">
      <div class="row">
        <div class="input-field col s6">
          <p><span class="red-text">＊</span>面談日</p>
          <%= f.datetime_field :schedule_at_date, class: "datepicker", placeholder: "クリックして選択してください" %>
        </div>
        <div class="input-field col s6">
          <p><span class="red-text">＊</span>時間</p>
          <%= f.datetime_field :schedule_at_time, class: "timepicker", placeholder: "クリックして選択してください" %>
        </div>
      </div>
      <div class="row">
        <div class="col s6">
          <p><span class="red-text">＊</span>記入メンター名</p>
          <%= f.text_field :mentor, placeholder: " ※初回は「初回」と記入" %>
        </div>
      </div>
      <div class="row">
        <div class="col s12">
          <p><span class="red-text"></span>伝言メモ</p>
          <%= f.text_area :memo, placeholder: " （例）次回は16時以降をご希望です。", class: "materialize-textarea" %>
        </div>
      </div>
      <%= f.hidden_field :student_id %>
      <div class="row">
        <div id="submit">
          <%= f.submit "送信",id: "submit_button", data: { disable_with: "送信中..." }, class: "waves-effect waves-light red btn" %>
        </div>
      </div>
    </div>
  </div>
  <% end %>
</div>

