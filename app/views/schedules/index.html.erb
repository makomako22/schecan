            <% else %>
            <td>-</td>
            <% end %>
            <td id="n_name"><%= link_to schedule.student.name, student_path(schedule.student.id) %></td>
            <td><span class="tooltipped" data-position="bottom" data-tooltip="<%= schedule.get_term(schedule) %>"><%= schedule.student.term %></span></td>
            <% if schedule.student.sheet.present? %>
            <td><%= link_to "表示する", schedule.student.sheet, target: "_blank" %></td>
            <% else %>
            <td>未登録</td>
            <% end %>
            <% if schedule.student.detail.present? %>
            <td><%= link_to "表示する", schedule.student.detail, target: "_blank" %></td>
            <% else %>
            <td>未登録</td>
            <% end %>
            <td><%= schedule.mentor %></td>
            <% if schedule.memo.present? %>
              <td><%= link_to "あり", schedule_path(schedule.id) %></td>
            <% else %>
              <td>なし</td>
            <% end %>
            <td><%= link_to(content_tag(:i, 'restore', class: 'material-icons'), edit_schedule_path(schedule.id)) %></td>
            <td><%= link_to(content_tag(:i, 'delete', class: 'material-icons'), schedule_path(schedule.id),method: :delete, data: { confirm: "本当に削除しますか？"}) %></td>
          </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
  <% else %>
  <div class="row">
    <div class="input-field col s12">
      <p class="center-align form_result">明日の面談はありません</p>
    </div>
  </div>
  <% end %>
  <br>
  <h2 class="form_title">リスケが必要な面談</h2>
  <p class="center-align">予定日が過ぎても行われていない面談です。</p>
  <% if @undo_schedules.present? %>
  <div class="row">
    <div class="input-field col s12">
      <table class="t_border striped centered">
        <thead>
          <tr>
            <th>面談日時</th>
            <th>受講生名</th>
            <th>受講期</th>
            <th>進捗シート</th>
            <th>前回担当</th>
            <th>メモ</th>
            <th>編集</th>
            <th>削除</th>
          </tr>
        </thead>
        <tbody>
          <% @undo_schedules.each do |schedule| %>
          <tr>
            <td><%= schedule.schedule_at.strftime("%-m月%d日(#{%w(日 月 火 水 木 金 土)[schedule.schedule_at.wday]}) %H:%M〜") %></td>
            <td><%= link_to schedule.student.name, student_path(schedule.student.id) %></td>
            <td><span class="tooltipped" data-position="bottom" data-tooltip="<%= schedule.get_term(schedule) %>"><%= schedule.student.term %></span></td>
            <% if schedule.student.sheet.present? %>
            <td><%= link_to "表示する", schedule.student.sheet, target: "_blank" %></td>
            <% else %>
