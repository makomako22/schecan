            <th>受講生名</th>
            <th>受講期</th>
            <th>進捗シート</th>
            <th>TM</th>
            <th>前回担当</th>
            <th>メモ</th>
            <th>編集</th>
            <th>削除</th>
          </tr>
        </thead>
        <tbody>
