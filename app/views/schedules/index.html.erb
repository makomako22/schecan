<% if @memo.present? %>  
<h2 class="schedule_title"><%= @memo.name%>校</h2>
<% end %> 
<% if params[:base_id].present? && @memo.memo? %>  
<div class="card">
  <div class="card-content red lighten-5">
    <span class="card-title"><b><%= @memo.memo_h %></b></span>
    <%= simple_format(@memo.memo) %>
  </div>
</div>
<% elsif params[:base_id].blank? %>
<div class="card">
  <div class="card-content red lighten-5">
    <span class="card-title"><b>お知らせ</b></span>
    <p>最初は受講生登録が大変だと思いますので、左メニューの一番上に受講生登録メニューを表示しました。<br>
      こちらは今月中に削除しますので、それ以降は上メニュー「受講生管理」から「受講生登録」を選び登録をお願いします。<br>
    不明な点やエラーのお知らせ、こういう機能が欲しいという方は@makoto-arakiまでご連絡ください。</p>
  </div>
</div>
<% end %>
<%= render partial: 'layouts/flash' %>
<h2 class="form_title"><%= @today.strftime("%-m月%-d日(#{%w(日 月 火 水 木 金 土)[@today.wday]})") %>の面談予定</h2>
<p class="center-align">面談後は「済」設定と次回の面談の登録を行いましょう。</p>
<% if @today_schedules.present? %>
<table class="t_border striped centered">
  <thead>
    <tr>
      <% if params[:base_id].blank? %>
      <th>拠点</th>
      <% else %>
      <% end %>
      <th>面談時間</th>
      <th>受講生名</th>
      <th>受講期</th>
      <th>進捗シート</th>
      <th>TM</th>
      <th>前回担当</th>
      <th>メモ</th>
      <th>編集</th>
      <th>削除</th>
    </tr>
  </thead>
  <tbody>
    <% @today_schedules.each do |schedule| %>
    <tr>
      <% if params[:base_id].blank? %>
      <td><%= schedule.base.name %></td>
      <% else %>
      <% end %>
      <% if schedule.checkbox == false %>
      <td id="time"><%= schedule.schedule_at.strftime("%H:%M〜") %></td>
      <% elsif schedule.checkbox == true %>
      <td><span class="green-text">面談完了</span></td>
      <% else %>
      <td>-</td>
      <% end %>
      <td id="name"><%= link_to schedule.student.name, student_path(schedule.student.id) %></td>
      <td><span class="tooltipped" data-position="bottom" data-tooltip="<%= schedule.get_term(schedule) %>"><%= schedule.student.term %></span></td>
      <td><%= link_to_if(schedule.student.sheet?, "表示する", schedule.student.sheet, target: "_blank") {"未登録"} %></td>
      <td><%= link_to_if(schedule.student.detail?, "表示する", schedule.student.detail, target: "_blank") {"未登録"} %></td>
      <td><%= schedule.mentor %></td>
      <td><%= link_to_if(schedule.memo?, "あり", schedule_path(schedule.id)) {"なし"} %></td>
      <td><%= link_to(content_tag(:i, 'restore', class: 'material-icons'), edit_schedule_path(schedule.id)) %></td>
      <td><%= link_to(content_tag(:i, 'delete', class: 'material-icons'), schedule_path(schedule.id),method: :delete, data: { confirm: "本当に削除しますか？"}) %></td>
    </tr>
    <% end %>
  </tbody>
</table>
<% else %>
<p class="center-align form_result">本日の面談はありません</p>
<% end %>
<br>
<h2 class="form_title"><%= @afterDay.strftime("%-m月%-d日(#{%w(日 月 火 水 木 金 土)[@afterDay.wday]})") %>の面談予定</h2>
