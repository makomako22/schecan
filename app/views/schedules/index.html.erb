<div class="form_wrapper wf-roundedmplus1c">
  <% if flash[:notice] %>
  <div id="card-alert" class="card green lighten-5">
    <div class="card-content green-text">
      <%= flash[:notice] %>
    </div>
  </div>
  <% end %>
  <% if flash[:alert] %>
  <div id="card-alert" class="card red lighten-5">
    <div class="card-content red-text">
      <%= flash[:alert] %>
    </div>
  </div>
  <% end %>
  <h2 class="form_title"><%= @today.strftime("%-m月%-d日") %>の面談予定</h2>
  <p class="center_line">面談後は「済」設定と次回の面談の登録を行いましょう。</p>
  <% if @today_schedules.present? %>
  <div class="row">
    <div class="input-field col s12">
      <table class="striped centered">
        <thead>
          <tr>
            <th>面談時間</th>
            <th>受講生名</th>
            <th>受講期</th>
            <th>進捗シート</th>
            <th>前回担当</th>
            <th>メモ</th>
            <th>編集</th>
            <th>削除</th>
          </tr>
        </thead>
        <tbody>
          <% @today_schedules.each do |schedule| %>
          <tr>
            <% if schedule.checkbox == false %>
            <td id="time"><%= schedule.schedule_at.strftime("%H:%M〜") %></td>
            <% elsif schedule.checkbox == true %>
            <td><span class="green-text">面談完了</span></td>
            <% else %>
            <td>-</td>
            <% end %>
            <td id="name"><%= link_to schedule.student.name, student_path(schedule.student.id) %></td>
            <td><%= schedule.student.term %></td>
            <% if schedule.student.sheet.present? %>
            <td><%= link_to "表示する", schedule.student.sheet, target: "_blank" %></td>
            <% else %>
            <td>未登録</td>
            <% end %>
            <td><%= schedule.mentor %></td>
            <% if schedule.memo.present? %>
              <td><%= link_to "あり", schedule_path(schedule.id) %></td>
            <% else %>
              <td>なし</td>
            <% end %>
            <td><%= link_to "編集", edit_schedule_path(schedule.id) %></td>
            <td><%= link_to "削除", schedule_path(schedule.id),method: :delete, data: { confirm: "本当に削除しますか？"} %></td>
          </tr>
          <% end %>
        </tbody>
      </table>
      <%= paginate(@today_schedules) %>
    </div>
  </div>
  <% else %>
  <div class="row">
    <div class="input-field col s12">
      <p class="center_line form_result">本日の面談はありません</p>
    </div>
  </div>
  <% end %>
  <br>
  <hr>
  <h2 class="form_title">リスケが必要な面談</h2>
  <p class="center_line">予定日が過ぎても行われていない面談です。</p>
  <% if @undo_schedules.present? %>
  <div class="row">
    <div class="input-field col s12">
      <table class="striped centered">
        <thead>
          <tr>
            <th>面談日時</th>
            <th>受講生名</th>
            <th>受講期</th>
            <th>進捗シート</th>
            <th>前回担当</th>
            <th>メモ</th>
            <th>編集</th>
            <th>削除</th>
          </tr>
        </thead>
        <tbody>
          <% @undo_schedules.each do |schedule| %>
          <tr>
            <td><%= schedule.schedule_at.strftime("%-m月%d日 %H:%M〜") %></td>
            <td><%= link_to schedule.student.name, student_path(schedule.student.id) %></td>
            <td><%= schedule.student.term %></td>
            <% if schedule.student.sheet.present? %>
            <td><%= link_to "表示する", schedule.student.sheet, target: "_blank" %></td>
            <% else %>
            <td>未登録</td>
            <% end %>
            <td><%= schedule.mentor %></td>
            <% if schedule.memo.present? %>
              <td><%= link_to "あり", schedule_path(schedule.id) %></td>
            <% else %>
              <td>なし</td>
            <% end %>
            <td><%= link_to "編集", edit_schedule_path(schedule.id) %></td>
            <td><%= link_to "削除", schedule_path(schedule.id),method: :delete, data: { confirm: "本当に削除しますか？"} %></td>
          </tr>
          <% end %>
        </tbody>
      </table>
      <%= paginate(@undo_schedules) %>
    </div>
  </div>
  <% else %>
  <div class="row">
    <div class="input-field col s12">
      <p class="center_line form_result">全ての予定が完了しています。</p>
    </div>
  </div>
  <% end %>
  <br>
  <hr>
  <h2 class="form_title">明日以降の面談予定</h2>
  <p class="center_line">メンターが足りない日を確認しておきましょう。</p>
  <% if @schedules.present? %>
  <div class="row">
    <div class="input-field col s12">
      <table class="striped centered">
        <thead>
          <tr>
            <th>面談予定日時</th>
            <th>受講生名</th>
            <th>受講期</th>
            <th>進捗シート</th>
            <th>前回担当</th>
            <th>メモ</th>
            <th>編集</th>
            <th>削除</th>
          </tr>
        </thead>
        <tbody>
          <% @schedules.each do |schedule| %>
          <tr>
            <td><%= schedule.schedule_at.strftime("%-m月%d日 %H:%M〜") %></td>
            <td><%= link_to schedule.student.name, student_path(schedule.student.id) %></td>
            <td><%= schedule.student.term %></td>
            <% if schedule.student.sheet.present? %>
            <td><%= link_to "表示する", schedule.student.sheet, target: "_blank" %></td>
            <% else %>
            <td>未登録</td>
            <% end %>
            <td><%= schedule.mentor %></td>
            <% if schedule.memo.present? %>
              <td><%= link_to "あり", schedule_path(schedule.id) %></td>
            <% else %>
              <td>なし</td>
            <% end %>
            <td><%= link_to "編集", edit_schedule_path(schedule.id) %></td>
            <td><%= link_to "削除", schedule_path(schedule.id),method: :delete, data: { confirm: "本当に削除しますか？"} %></td>
          </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
  <% else %>
  <div class="row">
    <div class="input-field col s12">
      <p class="center_line form_result">明日以降の面談予定はありません。</p>
    </div>
  </div>
  <% end %>
</div>

