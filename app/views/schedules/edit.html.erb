<% provide :title, " | 面談日編集" %>
<div class="form_wrapper wf-roundedmplus1c">
  <%= form_for(@schedule) do |f| %>
  <h2 class="form_title">面談日編集</h2>
  <p class="center_line">※「<span class="red-text">＊</span>」は必須項目</p>
  <%= render partial: 'layouts/flash' %>
  <div class="row">
    <div class="col s12">
      <div class="row">
        <div class="col s6">
          <p>面談状況</p>
          <div class="switch">
            <label>
              未
              <%= f.check_box :checkbox %>
              <span class="lever"></span>
              済
            </label>
          </div>
        </div>
      </div>
            <div class="row">
        <div class="input-field col s6">
          <p><span class="red-text">＊</span>面談日</p>
          <%= f.datetime_field :schedule_at_date, class: "datepicker", value: @schedule.schedule_at.strftime("%Y-%m-%d") %>
        </div>
        <div class="input-field col s6">
          <p><span class="red-text">＊</span>時間</p>
          <%= f.datetime_field :schedule_at_time, class: "timepicker", value: @schedule.schedule_at.strftime("%H:%M") %>
        </div>
      </div>
      <div class="row">
        <div class="col s6">
          <p><span class="red-text">＊</span>前回担当メンター名</p>
          <%= f.text_field :mentor %>
        </div>
      </div>
      <div class="row">
        <div class="col s12">
          <%= f.label :"メモ" %>
          <%= f.text_area :memo, class: "materialize-textarea" %>
        </div>
      </div>
      <%= f.hidden_field :student_id %>
      <div class="row">
        <div id="submit">
          <%= f.submit "送信",id: "submit_button", data: { disable_with: "送信中..." }, class: "waves-effect waves-light red btn" %>
        </div>
      </div>
    </div>
  </div>
  <% end %>
  <p class="center_line"><%= link_to "戻る", :back %></p>
</div>
