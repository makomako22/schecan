<% provide :title, " | 新規受講期登録" %>
<div class="student_wrapper wf-roundedmplus1c">
  <%= form_for(@term) do |f| %>
  <h2 class="form_title">新規受講期登録</h2>
  <p class="center-align">※「＊」は必須項目</p>
  <p class="center-align">※データ保持のため一度登録すると編集・削除はできません</p>
  <%= render partial: 'layouts/flash' %>
  <div class="row">
    <div class="col s12">
      <div class="row">
        <div class="input-field col s2">
          <%= f.label :"受講期(数字)＊" %>
          <%= f.text_field :term_i, class: "validate" %>
        </div>
        <div class="row">
          <div class="input-field col s12">
            <%= f.label :"受講期間＊" %>
            <%= f.text_field :term_t, value: "第○期 00/00(日) 〜 00/00(日)" %>
          </div>
        </div>
        <div class="row">
          <div id="submit">
            <%= f.submit "送信",id: "submit_button", data: { disable_with: "送信中..." }, class: "btn waves-effect waves-light" %>
          </div>
        </div>
        <br>
      </div>
    </div>
    <% end %>
  </div>
</div>
