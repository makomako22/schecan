<% provide :title, " | パスワード変更" %>
<div class="login_wrapper wf-roundedmplus1c">
  <%= form_for current_user do |f| %>
  <h2 class="form_title">パスワード編集</h2>
  <p class="center-align">※「<span class="red-text">＊</span>」は必須項目</p>
  <%= render partial: 'layouts/flash' %>
  <div class="row">
    <div class="col s12">
      <div class="center">
        <div class="input-field">
          <p>新しいパスワード<span class="red-text">＊</span></p>
          <%= f.password_field :password, autocomplete: "off" %>
        </div>
      </div>
      <div class="row">
          <div class="input-field">
          <p>確認<span class="red-text">＊</span></p>
          <%= f.password_field :password_confirmation, autocomplete: "off" %>
        </div>
      </div>
      <div class="row">
        <div id="submit">
          <%= f.submit "送信",id: "submit_button", data: { disable_with: "送信中..." }, class: "btn waves-effect waves-light" %>
        </div>
      </div>
    </div>
  </div>
  <% end %>
  <br>
</div>
