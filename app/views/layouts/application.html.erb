<!DOCTYPE html>
<html lang="ja">
<head>
  <meta http-equiv="content-language" content="ja">
  <meta name=”ROBOTS” content=”NOINDEX,NOFOLLOW”>
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, minimum-scale=1.0">
  <title>SCHE::CAN<%= yield :title %></title>
  <link rel="stylesheet" href="https://use.fontawesome.com/releases/v5.6.3/css/all.css" integrity="sha384-UHRtZLI+pbxtHCWp1t77Bi1L4ZtiqrqD80Kn4Z8NTSRyMA2Fd33n5dQ8lWUE00s/" crossorigin="anonymous">
  <%= stylesheet_link_tag    'application', media: 'all', 'data-turbolinks-track' => true %>
  <%= javascript_include_tag 'application', 'data-turbolinks-track' => true %>
  <%= csrf_meta_tags %>
  <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
  <link href="https://fonts.googleapis.com/earlyaccess/roundedmplus1c.css" rel="stylesheet" />
</head>
<body>
  <% if user_signed_in? %>
  <!-- Dropdown Structure -->
  <ul id="dropdown1" class="dropdown-content">
    <li><%= link_to "受講生一覧", students_path %></li>
    <li><%= link_to "受講生登録", new_student_path %></li>
  </ul>
  <% if user_signed_in? %>
  <ul id="dropdown2" class="dropdown-content">
    <li><%= link_to "ログアウト", destroy_user_session_path, method: :delete %></li>
    <li><%= link_to "パスワード変更", edit_user_path(current_user) %></li>
    <% if user_signed_in? %>
      <% if current_user.role == "admin" || current_user.role == "manager" %>
        <li><%= link_to "説明会登録", new_briefing_path %></li>
        <li><%= link_to "管理画面", adminmentor_root_path %></li>
      <% end %>
    <% end %>
  </ul>
  <% end %>
  <!-- ここまで -->
  <nav class="indigo darken-1 wf-roundedmplus1c">
    <div class="nav_wrapper">
      <a href="/" class="brand-logo"><%= image_tag "schecan.svg" %></a>
      <a href="#" data-activates="mobile-demo" class="button-collapse"><i class="fas fa-bars"></i></a>
      <ul class="right hide-on-med-and-down">
        <li><%= link_to "面談日一覧", schedules_path %></li>
        <li><a class="dropdown-button valign-wrapper" data-activates="dropdown1">受講生管理<i class="material-icons">arrow_drop_down</i></a></li>
        <li><%= link_to "受講期一覧", terms_path %></li>
        <% if user_signed_in? %>
          <li><a class="dropdown-button valign-wrapper" data-activates="dropdown2">メンター<%= current_user.username %><i class="material-icons">arrow_drop_down</i></a></li>
        <% end %>
        <li><%= link_to "使い方", use_schedules_path %></li>
      </ul>
      <ul class="side-nav" id="mobile-demo">
        <li><%= link_to "面談日一覧", schedules_path %></li>
        <ul>
        <li><%= link_to "池袋", schedules_path(base_id: 2) %></li>
        <li><%= link_to "早稲田", schedules_path(base_id: 5) %></li>
      </ul>
        <li>受講生管理
          <ul>
            <li><%= link_to "受講生一覧", students_path %></li>
            <li><%= link_to "受講生登録", new_student_path %></li>
          </ul>
        </li>
        <li><%= link_to "受講期一覧", terms_path %></li>
        <% if user_signed_in? %>
          <li>メンター<%= current_user.username %>
            <% if user_signed_in? %>
            <ul>
              <li><%= link_to "ログアウト", destroy_user_session_path, method: :delete %></li>
              <li><%= link_to "パスワード変更", edit_user_path(current_user) %></li>
              <% if user_signed_in? %>
                <% if current_user.role == "admin" || current_user.role == "manager" %>
                  <li><%= link_to "説明会登録", new_briefing_path %></li>
                  <li><%= link_to "管理画面", adminmentor_root_path %></li>
                <% end %>
              <% end %>
            </ul>
            <% end %>
          </li>
        <% end %>
        <li><%= link_to "使い方", use_schedules_path %></li>
      </ul>
    </div>
  </nav>
  <div class="top_wrapper wf-roundedmplus1c">
    <div class="row">
      <div class="col m3 s12 hidden-xs">
        <div class="tc_logo">
          <%= image_tag "techcamp.svg" %>
          <p class="center-align">〜 面談管理アプリ 〜</p>
        </div>
        <div class="search_bar">
          <%= form_tag('/students/search', method: :get) do %>
          <input name="keyword" placeholder="受講生を姓で検索" type="text" value=""><button class="btn-flat" title="検索" type="submit"><i class="material-icons btn-search">search</i></button></input>
          <% end %>
        </div>
        <div class="collection">
          <div class="collapsible-header indigo darken-1 white-text valign-wrapper">
            <i class="material-icons right">event</i>面談日一覧
          </div>
          <%= link_to schedules_path(base_id: 1), class: "collection-item" do %>新宿<i class="material-icons right">chevron_right</i><% end %>
          <%= link_to schedules_path(base_id: 2), class: "collection-item" do %>池袋<i class="material-icons right">chevron_right</i><% end %>
          <%= link_to schedules_path(base_id: 3), class: "collection-item" do %>東京駅前<i class="material-icons right">chevron_right</i><% end %>
          <%= link_to schedules_path(base_id: 4), class: "collection-item" do %>御茶ノ水<i class="material-icons right">chevron_right</i><% end %>
          <%= link_to schedules_path(base_id: 5), class: "collection-item" do %>早稻田<i class="material-icons right">chevron_right</i><% end %>
          <%= link_to schedules_path(base_id: 6), class: "collection-item" do %>名古屋<i class="material-icons right">chevron_right</i><% end %>
          <%= link_to schedules_path(base_id: 7), class: "collection-item" do %>梅田<i class="material-icons right">chevron_right</i><% end %>
        </div>
        <div class="collection">
          <div class="collapsible-header indigo darken-1 white-text valign-wrapper">
            <i class="material-icons right">people</i>受講生一覧
          </div>
          <%= link_to basis_path(1), class: "collection-item" do %>新宿<i class="material-icons right">chevron_right</i><% end %>
          <%= link_to basis_path(2), class: "collection-item" do %>池袋<i class="material-icons right">chevron_right</i><% end %>
          <%= link_to basis_path(3), class: "collection-item" do %>東京駅前<i class="material-icons right">chevron_right</i><% end %>
          <%= link_to basis_path(4), class: "collection-item" do %>御茶ノ水<i class="material-icons right">chevron_right</i><% end %>
          <%= link_to basis_path(5), class: "collection-item" do %>早稻田<i class="material-icons right">chevron_right</i><% end %>
          <%= link_to basis_path(6), class: "collection-item" do %>名古屋<i class="material-icons right">chevron_right</i><% end %>
          <%= link_to basis_path(7), class: "collection-item" do %>梅田<i class="material-icons right">chevron_right</i><% end %>
        </div>
        <div class="collection">
          <div class="collapsible-header indigo darken-1 white-text valign-wrapper">
            <i class="material-icons right">account_circle</i>受講生登録
          </div>
          <%= link_to new_student_path(base_id: 1), class: "collection-item" do %>新宿<i class="material-icons right">chevron_right</i><% end %>
          <%= link_to new_student_path(base_id: 2), class: "collection-item" do %>池袋<i class="material-icons right">chevron_right</i><% end %>
          <%= link_to new_student_path(base_id: 3), class: "collection-item" do %>東京駅前<i class="material-icons right">chevron_right</i><% end %>
          <%= link_to new_student_path(base_id: 4), class: "collection-item" do %>御茶ノ水<i class="material-icons right">chevron_right</i><% end %>
          <%= link_to new_student_path(base_id: 5), class: "collection-item" do %>早稻田<i class="material-icons right">chevron_right</i><% end %>
          <%= link_to new_student_path(base_id: 6), class: "collection-item" do %>名古屋<i class="material-icons right">chevron_right</i><% end %>
          <%= link_to new_student_path(base_id: 7), class: "collection-item" do %>梅田<i class="material-icons right">chevron_right</i><% end %>
        </div>
        <div class="collection">
          <div class="collapsible-header indigo darken-1 white-text valign-wrapper">
            <i class="material-icons right">announcement</i>拠点連絡登録
          </div>
          <%= link_to new_basis_path(base_id: 1), class: "collection-item" do %>新宿<i class="material-icons right">chevron_right</i><% end %>
          <%= link_to new_basis_path(base_id: 2), class: "collection-item" do %>池袋<i class="material-icons right">chevron_right</i><% end %>
          <%= link_to new_basis_path(base_id: 3), class: "collection-item" do %>東京駅前<i class="material-icons right">chevron_right</i><% end %>
          <%= link_to new_basis_path(base_id: 4), class: "collection-item" do %>御茶ノ水<i class="material-icons right">chevron_right</i><% end %>
          <%= link_to new_basis_path(base_id: 5), class: "collection-item" do %>早稻田<i class="material-icons right">chevron_right</i><% end %>
          <%= link_to new_basis_path(base_id: 6), class: "collection-item" do %>名古屋<i class="material-icons right">chevron_right</i><% end %>
          <%= link_to new_basis_path(base_id: 7), class: "collection-item" do %>梅田<i class="material-icons right">chevron_right</i><% end %>
        </div>
        <div class="collection">
          <div class="collapsible-header indigo darken-1 white-text valign-wrapper">
            <i class="material-icons right">open_in_new</i>参照リンク
          </div>
          <%= link_to "https://master.tech-camp.in/admin/users", target: "_blank", class: "collection-item" do %>TMユーザー管理<i class="material-icons right">chevron_right</i><% end %>
          <%= link_to "https://div.docbase.io/posts/509050", target: "_blank", class: "collection-item" do %>初回面談マニュアル<i class="material-icons right">chevron_right</i><% end %>
          <%= link_to "https://div.docbase.io/posts/513546", target: "_blank", class: "collection-item" do %>面談2回目以降<i class="material-icons right">chevron_right</i><% end %>
          <%= link_to "https://docs.google.com/spreadsheets/d/1kIwO6Ikbic2nckM1PdYjH9gQ45s8JHF6xelbhLPgPsg/edit#gid=265225693", target: "_blank", class: "collection-item" do %>アイスバーグ確認<i class="material-icons right">chevron_right</i><% end %>
          <%= link_to "https://docs.google.com/spreadsheets/d/1NZcK5PTqt7fd9B8rJXK6vOqs5rzDpgiQco6q799dUiE/edit#gid=121918679", target: "_blank", class: "collection-item" do %>説明会参加者フォーム<i class="material-icons right">chevron_right</i><% end %>
          <%= link_to "https://docs.google.com/spreadsheets/d/102bTd972W-rl4xZSp4nLcCnUUox_8XbEQL29Qrj0tNU/edit#gid=1115526001", target: "_blank", class: "collection-item" do %>セールス計画値<i class="material-icons right">chevron_right</i><% end %>
          <%= link_to "https://docs.google.com/presentation/d/17C4LqlN-QC4ZXviCR0Kbc5Tg1KchcSMaTUBqeZj-fQk/edit#slide=id.g439eff444c_2_141", target: "_blank", class: "collection-item" do %>説明会資料<i class="material-icons right">chevron_right</i><% end %>
        </div>
      </div>
      <div class="col m9 s12 mar_5">
        <%= yield %>
      </div>

    </div>
  </div>
  <div id="footer_container"></div>
  <footer class="page-footer indigo darken-1">
    <div class="footer_wrapper">
      <div class="row">
        <div class="col l6 s12">
          <h5 class="footer_img"><%= image_tag "schecan.svg" %></h5>
          <p class="grey-text text-lighten-4">面談日をしっかり把握し、最高のメンタリングを。</p>
        </div>
        <div class="col l4 offset-l2 s12">
          <h5 class="white-text">MENU</h5>
          <ul>
            <li><%= link_to "新宿", schedules_path(base_id: 1), class: "grey-text text-lighten-3" %></li>
            <li><%= link_to "池袋", schedules_path(base_id: 2), class: "grey-text text-lighten-3" %></li>
            <li><%= link_to "東京駅前", schedules_path(base_id: 3), class: "grey-text text-lighten-3" %></li>
            <li><%= link_to "御茶ノ水", schedules_path(base_id: 4), class: "grey-text text-lighten-3" %></li>
            <li><%= link_to "早稲田", schedules_path(base_id: 5), class: "grey-text text-lighten-3" %></li>
            <li><%= link_to "名古屋", schedules_path(base_id: 6), class: "grey-text text-lighten-3" %></li>
            <li><%= link_to "梅田", schedules_path(base_id: 7), class: "grey-text text-lighten-3" %></li>
            <li><%= link_to "受講生一覧", students_path, class: "grey-text text-lighten-3" %></li>
            <li><%= link_to "受講生登録", new_student_path, class: "grey-text text-lighten-3" %></li>
            <li><%= link_to "使い方", use_schedules_path, class: "grey-text text-lighten-3" %></li>
          </ul>
        </div>
      </div>
    </div>
    <div class="footer-copyright">
      <div class="footer_wrapper">
        © 2018 TECH::CAMP
      </div>
    </div>
  </footer>
  <% else %>
    <div class="row">
      <div class="login_body wf-roundedmplus1c col l12 s12">
        <%= yield %>
      </div>
    </div>
  <% end %>
</body>
<script>
  $(document).ready(function() {
    $('#card-alert').delay(3000).fadeOut(500);
  });
</script>
</html>
