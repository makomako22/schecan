<% provide :title, " | 受講生一覧" %>
  <h2 class="form_title"><%= @base.name %>校・受講生一覧</h2>
  <p class="center-align">名前をクリックすると詳細が表示されます。</p>
  <%= render partial: 'layouts/flash' %>
  <div class="row">
    <div class="input-field col s12">
      <% if @students.present? %>
      <table class="t_border striped centered">
        <thead>
          <tr>
            <th>受講期</th>
            <th>名前（漢字）</th>
            <th>名前（カナ）</th>
            <th>進捗シート</th>
            <th>アイスバーグ</th>
            <th>TM</th>
            <th>面談日</th>
          </tr>
        </thead>
        <tbody>
          <% @students.each do |student| %>
          <tr>
            <td><%= student.term == 1000 ? "--" : student.term %></td>
            <td><%= link_to student.name, student_path(student.id) %></td>
            <td><%= student.name_kana %></td>
            <td><%= link_to_if(student.sheet?, "表示する", student.sheet, target: "_blank") {"未登録"} %></td>
            <td><%= link_to_if(student.iceberg?, "表示する", student.iceberg, target: "_blank") {"未登録"} %></td>
            <td><%= link_to_if(student.detail?, "表示する", student.detail, target: "_blank") {"未登録"} %></td>
            <td><%= link_to "登録する", new_schedule_path(student_id: student.id) %></td>
          </tr>
          <% end %>
        </tbody>
      </table>
      <%= paginate(@students) %>
      <% else %>
        <p class="center-align form_result">該当する受講生はいません。</p>
      <% end %>
  </div>
</div>
